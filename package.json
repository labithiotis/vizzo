{
  "name": "vizzo-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run checks",
    "dev": "bun run --cwd docs dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "checks": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "lefthook": "2.1.17",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
