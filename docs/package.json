{
  "name": "@vizzo/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "bun run generate && vite build",
    "build:types": "wrangler types",
    "dev": "bun run generate && vite dev --host",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate": "bun scripts/generateDocs.ts && biome format --write public/schema.json src/highlight.gen.css"
  },
  "dependencies": {
    "@tanstack/highlight": "1.0.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@vizzo/core": "workspace:*",
    "@vizzo/schemas": "workspace:*",
    "jsurl2": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  }
}
